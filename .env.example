# Sales Dashboard Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (for AI Assistant features)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# Database Configuration
# DB_PASSWORD is REQUIRED - the app has no default password
DB_SERVER=192.168.1.4
DB_USER=sa
DB_PASSWORD=your_db_password
# Database name (optional, default: SalesManagement)
# SALES_DB=SalesManagement

# Flask Configuration
# FLASK_SECRET_KEY=your_secret_key_here
# FLASK_DEBUG=False

# Route optimizer: Yandex map tiles (free Tiles API key from https://developer.tech.yandex.ru/)
# Without it the route maps use OpenStreetMap.
# ROUTES_YANDEX_TILES_KEY=your_tiles_api_key

# Live truck map alerts to a Telegram group. Set ONLY on CT115 (exactly one process may send; deploy/README.md).
# ROUTES_LIVE_ALERTS=1
# ROUTES_LIVE_TG_TOKEN=123456:ABC   (falls back to TELEGRAM_BOT_TOKEN)
# ROUTES_LIVE_TG_CHAT=-1001234567890

# Route optimizer: roads and learning (all optional; see deploy/README.md)
# Road engine: valhalla_time (default: managers' cars get Valhalla minutes, km from the OSM graph) | valhalla | osm (off)
# ROUTES_ROAD_ENGINE=valhalla_time
# Valhalla tiles and matrix caches (default %PROGRAMDATA%\route_optimizer\valhalla, ~110 MB)
# ROUTES_VALHALLA_DIR=C:\RoutesData\valhalla
# Truck travel-time model. Leave UNSET so the program chooses it from drivers' tracks;
# setting it (model | valhalla) pins the choice and overrides learning.
# ROUTES_TRUCK_TIME=
# Nightly learning at 03:00 Yerevan (default on); 0 = off
# ROUTES_LEARNING_NIGHTLY=0
